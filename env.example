# Copy this file to .env and fill in real values before starting the server.
# .env is gitignored -- never commit real keys.

# LLM (required, no default)
LLM_BINDING_API_KEY=
LLM_BINDING_HOST=

# LLM (optional, defaults shown)
LLM_MODEL=qwen3.6-plus
VISION_MODEL=qwen3.6-plus
FAST_LLM_MODEL=qwen3.6-flash

# Embedding
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_DB_NAME=lightrag

# Storage paths (relative to where the server is launched from)
WORKING_DIR=./rag_storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output

# Safety net: seconds before a stuck document-processing task is marked failed
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=1800
